Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"menger", "[", 
    RowBox[{"cornerPt_", ",", "sideLen_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"menger", "[", 
      RowBox[{
       RowBox[{"cornerPt", "+", 
        RowBox[{"#1", "*", 
         RowBox[{"(", 
          RowBox[{"sideLen", "/", "4"}], ")"}]}]}], ",", 
       RowBox[{"sideLen", "/", "4"}], ",", 
       RowBox[{"n", "-", "1"}]}], "]"}], "&"}], "/@", " ", "pieces"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"menger", "[", 
    RowBox[{"cornerPt_", ",", "sideLen_", ",", "0"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Hue", "[", 
      RowBox[{"N", "[", 
       RowBox[{"1", "-", 
