     RowBox[{"EdgeForm", "[", "]"}], ",", 
     RowBox[{"Cuboid", "[", 
      RowBox[{"cornerPt", ",", 
       RowBox[{"cornerPt", "+", 
        RowBox[{"sideLen", "*", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}]}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
