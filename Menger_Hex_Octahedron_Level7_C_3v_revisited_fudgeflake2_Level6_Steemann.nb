    RowBox[{
     RowBox[{
     "4", " ", "we", " ", "get", " ", "16", " ", "layers", " ", "where", " ", 
      "the", " ", "second", " ", "half", " ", "is", " ", "the", " ", "same", 
      " ", "as", " ", "the", " ", "first", " ", "half", " ", "but", " ", "in",
       " ", "reversed", " ", "order", " ", 
      RowBox[{
       RowBox[{"(", "palindromic", ")"}], ".", "All"}], " ", "layer", " ", 
      "come", " ", "in", " ", "symmetric", " ", 
      RowBox[{"(", "reflected", ")"}], " ", 
      RowBox[{"pairs", ".", "E", ".", "g", ".", "layer"}], " ", "4", " ", 
      "is", " ", "a", " ", "symmetric", " ", "version", " ", "of", " ", 
