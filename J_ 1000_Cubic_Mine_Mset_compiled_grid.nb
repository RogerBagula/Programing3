Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cNumberOfz2ToEscape", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"z", ",", "_Complex"}], "}"}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"escapeCount", "=", "0"}], ",", 
          RowBox[{"nz", "=", 
           RowBox[{"N", "[", "z", "]"}]}], ",", 
          RowBox[{"nzold", "=", 
           RowBox[{"0.", "+", 
            RowBox[{"0.", " ", "I"}]}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "nz", "]"}], "^", "2"}], "+", 
               RowBox[{
                RowBox[{"Im", "[", "nz", "]"}], "^", "2"}]}], "]"}], "<", 
             "16."}], "&&", 
            RowBox[{"escapeCount", "<", "255"}], "&&", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"nz", "-", "nzold"}], "]"}], ">", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "3"}]}]}]}], ",", 
           RowBox[{
            RowBox[{"nzold", "=", "nz"}], ";", "\[IndentingNewLine]", 
            RowBox[{"nz", "=", 
             RowBox[{
              FractionBox["1", "3"], " ", 
              RowBox[{"(", 
               RowBox[{"2", "-", "nz", "+", 
                SuperscriptBox["nz", "2"], "+", 
                SuperscriptBox["nz", "3"]}], ")"}]}]}], ";", 
            RowBox[{"(*", 
             RowBox[{"same", " ", "as", " ", 
              RowBox[{"g", "[", 
               RowBox[{"nz", ",", "z"}], "]"}], " ", "but", " ", "inlined"}], 
             "*)"}], 
            RowBox[{"escapeCount", "++"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"escapeCount", "*", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"nz", "-", "nzold"}], "]"}], ">", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "3"}]}]}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"ArcTan", "[", "nz", "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{"ArcTan", "[", "nz", "]"}], " ", 
               RowBox[{"Tan", "[", "1.", "]"}]}], "-", 
              RowBox[{"Arg", "[", "z", "]"}]}], "]"}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"Arg", "[", "nz", "]"}], "]"}]}], "]"}]}]}]}], "]"}], 
      ",", 
      RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
      RowBox[{"CompilationOptions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<InlineExternalDefinitions\>\"", "->", "True"}], 
        "}"}]}]}], "]"}]}], ";"}], "\n"}]], "Input",
