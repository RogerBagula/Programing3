Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FractalPureCompiled", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ReMin_", ",", "ReMax_", ",", "ReSteps_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ImMin_", ",", "ImMax_", ",", "ImSteps_"}], "}"}]}], "}"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xs", ",", "ys"}], "}"}], ",", 
     RowBox[{
      RowBox[{"xs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"ReMin", ",", "ReMax", ",", "ReSteps"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ys", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"ImMin", ",", "ImMax", ",", "ImSteps"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"cNumberOfz2ToEscape", "[", 
         RowBox[{"x", "+", 
          RowBox[{"I", " ", "y"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "ys"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xs"}], "}"}]}], "]"}]}]}], "]"}]}], 
