                  RowBox[{
                   RowBox[{"Norm", "[", "p", "]"}], ">", "0"}], ",", 
                  RowBox[{"Sow", "[", "p", "]"}]}], "]"}], ";"}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Min", "[", 
                RowBox[{"batchSize", ",", 
