                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], "*", "batchSize"}]}]}], 
                "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
