         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", "Generate"}]}]}]}]}]}]}]}], " ", "points", " ", 
     "in", " ", "batches", " ", "using", " ", 
     RowBox[{"Reap", "/", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Sow", "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
        "--"}], "--"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"batchSize", "=", "5000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"batches", "=", 
     RowBox[{"Ceiling", "[", 
      RowBox[{"numOrbits", "/", "batchSize"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"M", ",", "p"}], "}"}], ",", 
               RowBox[{
                RowBox[{"M", "=", 
                 RowBox[{
                 "randomReducedWordMatrix", "[", "wordLength", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"p", "=", 
                 RowBox[{"mapToSphere", "[", 
                  RowBox[{"M", ",", "startPoint"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
