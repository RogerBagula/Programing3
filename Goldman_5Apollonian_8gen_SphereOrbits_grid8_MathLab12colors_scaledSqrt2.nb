            RowBox[{
             RowBox[{"generators", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "idxList"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"normalizeSL3", "[", "M", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
            RowBox[{"--", "Map"}]}]}]}]}]}]}]}], " ", "matrix", " ", "action",
      " ", "to", " ", "unit", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"sphere", "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
       "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mapToSphere", "[", 
      RowBox[{"M_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v", ",", "vproj"}], "}"}], ",", 
       RowBox[{
        RowBox[{"v", "=", 
         RowBox[{"M", ".", "p"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "v", "]"}], "]"}], "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"0.", ",", "0.", ",", "0."}], "}"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"vproj", "=", 
         RowBox[{"v", "/", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", "v", "]"}], "]"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"projective", " ", "normalization"}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", "vproj", "]"}], "==", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.", ",", "0.", ",", "0."}], "}"}], ",", 
          RowBox[{"vproj", "/", 
           RowBox[{"Norm", "[", "vproj", "]"}]}]}], "]"}]}]}], "  ", 
      RowBox[{"(*", 
       RowBox[{"map", " ", "to", " ", "unit", " ", "sphere"}], "*)"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
