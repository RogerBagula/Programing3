                "]"}]}], "}"}], ",", "\n", "\t\t\t\t", 
             RowBox[{"PlotRange", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"ymin", ",", "ymax"}], "}"}]}], "}"}]}], ",", "\n", 
             "\t\t\t\t", 
             RowBox[{"ImageSize", " ", "\[Rule]", " ", "resolution"}]}], "\n",
