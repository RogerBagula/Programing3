Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Two", "-", 
    RowBox[{"trace", " ", "compiled", " ", "Maskit", " ", "escape"}], "-", 
    RowBox[{"time", " ", "program", " ", 
     RowBox[{"(", 
      RowBox[{"adapted", " ", "from", " ", "Dieter", " ", 
       RowBox[{"Steemann", "'"}], "s", " ", "Program"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Parameters", ":", 
       RowBox[{
        RowBox[{"set", " ", "the", " ", "two", " ", "traces", " ", 
         RowBox[{"here", "--"}]}], "-"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"t1", "=", 
     RowBox[{
      RowBox[{"-", "1.6852299546352716`"}], "+", 
      RowBox[{"0.2000000000000000`", " ", "\[ImaginaryI]"}]}]}], ";"}], "  ", 
   
   RowBox[{"(*", 
    RowBox[{"first", " ", "trace"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t2", "=", 
     RowBox[{"1.80785524", "+", 
      RowBox[{"I", "*", "0.136998688"}]}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"second", " ", "trace"}], " ", "*)"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Compiled"}]}], " ", "escape"}], "-", 
     RowBox[{"time", " ", "function", " ", "with", " ", "two", " ", 
      RowBox[{"traces", ":", 
       RowBox[{
        RowBox[{
         RowBox[{"kleinC2", "[", 
          RowBox[{"z", ",", "t1", ",", "t2"}], "]"}], "--"}], "-"}]}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"kleinC2", "=", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"z", ",", "_Complex"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t1c", ",", "_Complex"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t2c", ",", "_Complex"}], "}"}]}], "}"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", ",", "v", ",", "xi", ",", "yi", ",", "zi", ",", 
           RowBox[{"k", "=", "1"}], ",", 
           RowBox[{"low", "=", 
            RowBox[{"1", "+", "I"}]}], ",", 
           RowBox[{"high", "=", 
            RowBox[{"1", "+", "I"}]}], ",", "n", ",", "tForSep", ",", "tA", 
           ",", "tB"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "choose", " ", "which", " ", "trace", " ", "controls", " ", "the", 
            " ", "separation"}], "-", 
           RowBox[{"line", " ", "geometry", " ", 
            RowBox[{"(", 
             RowBox[{"use", " ", "t2", " ", "by", " ", "default"}], ")"}]}]}],
           "*)"}], 
         RowBox[{
          RowBox[{"tForSep", "=", "t2c"}], ";", "\[IndentingNewLine]", 
          RowBox[{"tA", "=", "t1c"}], ";", 
          RowBox[{"(*", 
           RowBox[{
           "used", " ", "in", " ", "one", " ", "M\[ODoubleDot]bius", " ", 
            "branch"}], "*)"}], 
          RowBox[{"tB", "=", "t2c"}], ";", 
          RowBox[{"(*", 
           RowBox[{
           "used", " ", "in", " ", "the", " ", "other", " ", 
            "M\[ODoubleDot]bius", " ", "branch"}], "*)"}], 
          RowBox[{"xi", "=", 
           RowBox[{"Re", "[", "z", "]"}]}], ";", 
          RowBox[{"yi", "=", 
           RowBox[{"Im", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"u", "=", 
           RowBox[{"Re", "[", "tForSep", "]"}]}], ";", 
          RowBox[{"v", "=", 
           RowBox[{"Im", "[", "tForSep", "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"(*", 
           RowBox[{"quick", " ", "bounding", " ", 
            RowBox[{"check", ":", 
             RowBox[{"keep", " ", "same", " ", "as", " ", "original"}]}]}], 
           "*)"}], 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"yi", "<", "0"}], "||", 
             RowBox[{"yi", ">", "u"}]}], ",", 
            RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zi", "=", 
           RowBox[{"(", 
            RowBox[{"1.", "+", "I"}], ")"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{"(*", 
            RowBox[{
            "fold", " ", "x", " ", "coordinate", " ", "into", " ", 
             "fundamental", " ", "strip", " ", 
             RowBox[{"(", 
              RowBox[{"same", " ", "as", " ", "original"}], ")"}]}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"xi", "=", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"xi", "+", "1.", "+", 
                  RowBox[{"v", " ", 
                   RowBox[{"yi", "/", "u"}]}]}], ",", "2"}], "]"}], "-", "1", 
               "-", 
               RowBox[{"v", " ", 
                RowBox[{"yi", "/", "u"}]}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"zi", "=", 
              RowBox[{"xi", "+", 
               RowBox[{"I", " ", "yi"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"separation", "-", 
               RowBox[{"line", " ", 
                RowBox[{"test", ":", 
                 RowBox[{
                 "choose", " ", "branch", " ", "and", " ", "apply", " ", 
                  "corresponding", " ", "M\[ODoubleDot]bius", " ", 
                  "map"}]}]}]}], "*)"}], 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"yi", "<", 
                RowBox[{
                 RowBox[{"u", "/", "2."}], "+", 
                 RowBox[{
                  RowBox[{"Sign", "[", 
                   RowBox[{"xi", "+", 
                    RowBox[{"v", "/", "2"}]}], "]"}], " ", "0.2", "*", "u", 
                  " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "5."}], " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"xi", "+", 
                    RowBox[{"v", "/", "2"}]}], "]"}]}], "]"}]}], ")"}]}]}]}], 
               ",", 
               RowBox[{"(*", 
                RowBox[{"branch", " ", 
                 RowBox[{"A", ":", 
                  RowBox[{"use", " ", "trace", " ", "tA"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"zi", "-", "low"}], "]"}], "<", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "4"}]}]}], ",", 
                  RowBox[{
                   RowBox[{"k", "=", 
                    RowBox[{"-", "n"}]}], ";", 
                   RowBox[{"Break", "[", "]"}]}], ",", 
                  RowBox[{"low", "=", "zi"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
                RowBox[{"(*", 
                 RowBox[{"M\[ODoubleDot]bius", "-", 
                  RowBox[{"like", " ", "step", " ", "using", " ", "tA"}]}], 
                 "*)"}], 
                RowBox[{"zi", "=", 
                 RowBox[{
                  RowBox[{"I", "*", "tA"}], "+", 
                  RowBox[{"1.", "/", "zi"}]}]}]}], ",", 
               RowBox[{"(*", 
                RowBox[{"branch", " ", 
                 RowBox[{"B", ":", 
                  RowBox[{"use", " ", "trace", " ", "tB"}]}]}], "*)"}], 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"zi", "-", "high"}], "]"}], "<", 
                   RowBox[{"10", "^", 
                    RowBox[{"-", "4"}]}]}], ",", 
                  RowBox[{
                   RowBox[{"k", "=", 
                    RowBox[{"-", "n"}]}], ";", 
                   RowBox[{"Break", "[", "]"}]}], ",", 
                  RowBox[{"high", "=", "zi"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"zi", "=", 
                 RowBox[{"I", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"I", "*", "zi"}], "+", "tB"}], ")"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"k", "=", "2"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"xi", "=", 
              RowBox[{"Re", "[", "zi", "]"}]}], ";", 
             RowBox[{"yi", "=", 
              RowBox[{"Im", "[", "zi", "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"yi", "<", "0"}], "||", 
                RowBox[{"yi", ">", "u"}]}], ",", 
               RowBox[{"Break", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"k", "=", "3"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "1", ",", "30"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "k"}]}], "]"}], ",", 
       RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
       RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Image"}]}], " ", "grid", " ", 
      RowBox[{"parameters", " ", "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"res", "=", "2000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xres", "=", "res"}], ";", 
    RowBox[{"yres", "=", "res"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", 
     RowBox[{"0.25", "/", 
      RowBox[{"(", 
       RowBox[{"xres", "-", "1"}], ")"}]}]}], ";", 
    RowBox[{"dy", "=", 
     RowBox[{"0.25", "/", 
      RowBox[{"(", 
       RowBox[{"yres", "-", "1"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"disk", " ", "mapping", " ", "parameters"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "=", 
     RowBox[{"-", "I"}]}], ";", 
    RowBox[{"r2", "=", 
     RowBox[{"1.", "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "Build"}]}], " ", "the", " ", "escape"}], "-", 
      RowBox[{"time", " ", "matrix", " ", "in", " ", "parallel"}]}], ",", 
     RowBox[{"calling", " ", "kleinC2", " ", "with", " ", "t1"}], ",", 
     RowBox[{
      RowBox[{"t2", "--"}], "-"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"img", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", ",", "zval"}], "}"}], ",", 
         RowBox[{
          RowBox[{"q", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", 
              RowBox[{"I", " ", "y"}]}], ")"}], "-", "p"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"zval", "=", 
           RowBox[{"p", "+", 
            RowBox[{"r2", "/", 
             RowBox[{"Conjugate", "[", "q", "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"kleinC2", "[", 
           RowBox[{"zval", ",", "t1", ",", "t2"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "1"}], ",", "0", ",", "dy"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "dx"}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", "Color"}]}], " ", "mapping", " ", "and", " ", 
