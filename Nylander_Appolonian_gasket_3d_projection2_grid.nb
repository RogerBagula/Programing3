Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Mathematica", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"chains", "=", 
     RowBox[{"{", 
      RowBox[{"N", "[", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", 
               RowBox[{"E", "^", 
                RowBox[{"(", 
                 RowBox[{"I", " ", "theta"}], ")"}]}]}], ",", 
              RowBox[{"Sqrt", "[", "3", "]"}]}], "}"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"theta", ",", 
             RowBox[{"Pi", "/", "6"}], ",", 
             RowBox[{"3", 
              RowBox[{"Pi", "/", "2"}]}], ",", 
             RowBox[{"2", 
              RowBox[{"Pi", "/", "3"}]}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"2", "-", 
             RowBox[{"Sqrt", "[", "3", "]"}]}]}], "}"}], "}"}]}], "]"}], 
       "]"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Reflect", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z2_", ",", "r2_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z1_", ",", "r1_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"r1", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"z2", "-", "z1"}], ")"}], 
             RowBox[{"Conjugate", "[", 
              RowBox[{"z2", "-", "z1"}], "]"}]}], "-", 
            RowBox[{"r2", "^", "2"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"z1", "+", 
          RowBox[{"a", " ", 
           RowBox[{"(", 
            RowBox[{"z2", "-", "z1"}], ")"}]}]}], ",", 
         RowBox[{"a", " ", "r2"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"chains", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"chains", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Reflect", "[", 
               RowBox[{"#", ",", 
                RowBox[{"chains", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "j", ",", "1"}], "]"}], "]"}]}], "]"}], 
              "&"}], ",", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Delete", "[", 
                RowBox[{
                 RowBox[{"chains", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "j"}], "]"}], ",", 
               "1"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}], ";"}]}]}]], "Input",\

