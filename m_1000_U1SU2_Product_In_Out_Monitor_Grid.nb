Cell[CellGroupData[{

Cell["\<\
3D Mandelbrot of an U(1)*SU(2) type of serial pre-transform modulo4\
\>", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 CellChangeTimes->{{3.983338719290524*^9, 3.983338725232677*^9}, {
  3.983338758971669*^9, 3.9833387636473713`*^9}},
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"6841399b-3ed9-42ba-a7b4-73e809c49680"],

Cell["\<\
(*Mandelbrot with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 25 Mov 2005 \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 16) && (escapeCount < 255) && \
(Abs[nz-nzold]>10^(-3)),
\t\tnzold=nz;
\t\tnz=-\[ImaginaryI] nz^4 z^2+(1-\[ImaginaryI]) nz^2 \
z^3+z^4+(1+\[ImaginaryI]) nz^4 z Conjugate[nz]^2+2 \[ImaginaryI] nz^2 z^2 \
Conjugate[nz]^2-(1-\[ImaginaryI]) z^3 Conjugate[nz]^2-nz^4 \
Conjugate[nz]^4-(1+\[ImaginaryI]) nz^2 z Conjugate[nz]^4-\[ImaginaryI] z^2 \
Conjugate[nz]^4;
\t\t++escapeCount
\t];
\tescapeCount*If[(Abs[nz-nzold]>10^(-1)),Arg[nz],Abs[ArcTan[nz]+I*ArcTan[nz]*\
Tan[1]-Arg[z]]]
\t]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.636885471970562*^9, 3.636885495570519*^9}, {
   3.636886113868834*^9, 3.636886158088616*^9}, 3.636886228723032*^9, {
