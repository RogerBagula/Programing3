\f0\fs24 \cf0 // roto_mandel.cpp\
#include <bits/stdc++.h>\
using namespace std;\
\
struct C \{ double re, im; \};\
inline C add(const C &a, const C &b)\{ return \{a.re+b.re, a.im+b.im\}; \}\
inline C sq(const C &a)\{ return \{a.re*a.re - a.im*a.im, 2*a.re*a.im\}; \}\
inline double mag2(const C &a)\{ return a.re*a.re + a.im*a.im; \}\
\
int main()\{\
    // Grid and sampling parameters\
    const int NA = 120; // samples for a\
    const int NB = 120; // samples for b\
    const int NX = 60;  // samples for x0\
    const int NY = 60;  // samples for y0\
    const int maxIter = 500;\
    const double aMin=-2.0, aMax=1.0;\
    const double bMin=-1.5, bMax=1.5;\
    const double xMin=-1.5, xMax=1.5;\
    const double yMin=-1.5, yMax=1.5;\
\
    // Rotation angle in radians (change to animate)\
    const double theta = 0.8; // rotate in XW plane\
    const double cosT = cos(theta), sinT = sin(theta);\
\
    ofstream out("points.csv");\
    out << "x,y,z,iter\\n";\
\
    for(int ia=0; ia<NA; ++ia)\{\
        double a = aMin + (aMax-aMin) * ia / (NA-1);\
        for(int ib=0; ib<NB; ++ib)\{\
            double b = bMin + (bMax-bMin) * ib / (NB-1);\
            C c\{a,b\};\
            for(int ix=0; ix<NX; ++ix)\{\
                double x0 = xMin + (xMax-xMin) * ix / (NX-1);\
                for(int iy=0; iy<NY; ++iy)\{\
                    double y0 = yMin + (yMax-yMin) * iy / (NY-1);\
                    C z\{ x0, y0 \};\
                    int iter=0;\
                    while(iter < maxIter && mag2(z) <= 4.0)\{\
                        z = add(sq(z), c);\
                        ++iter;\
                    \}\
                    // Keep points that did NOT escape (inside set) or optionally those that escaped\
                    if(iter == maxIter)\{\
                        // 4D point: (a, b, x0, y0)\
                        double X = a, Y = b, Z = x0, W = y0;\
                        // rotate in XW plane: (X', W') = (cosT*X - sinT*W, sinT*X + cosT*W)\
                        double Xp = cosT*X - sinT*W;\
                        double Wp = sinT*X + cosT*W;\
                        // project 4D (Xp, Y, Z, Wp) to 3D by dropping Wp into Z axis offset\
                        double px = Xp;\
                        double py = Y;\
                        double pz = Z + 0.5 * Wp;\
                        out << px << "," << py << "," << pz << "," << iter << "\\n";\
                    \}\
                \}\
            \}\
        \}\
    \}\
    out.close();\
    cerr << "Wrote points.csv\\n";\
    return 0;\
\}\
