Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dynamicNewtonPic", "[", 
    RowBox[{"fIn_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"var_", ",", "varMin_", ",", "varMax_"}], "}"}], ",", " ", 
     "resolution_", ",", " ", 
     RowBox[{"bail_", ":", " ", "50"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "f", ",", " ", "n", ",", " ", "limitInfo", ",", " ", "color", ",", " ", 
       "colors", ",", " ", "roots", ",", " ", "preColors", ",", " ", "step", 
       ",", " ", "limitData", ",", " ", "\n", "\t ", "r", ",", " ", "xmin", 
       ",", "xmax", ",", "ymin", ",", "ymax", ",", " ", "z", ",", " ", 
       "pic"}], "}"}], ",", "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", "fIn"}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"A", " ", "very", " ", "standard", " ", "example"}], " ", 
       "*)"}], "\n", "\t", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Simplify", "[", 
           RowBox[{"var", " ", "-", " ", 
            RowBox[{
             RowBox[{"f", "[", "var", "]"}], "/", 
             RowBox[{
              RowBox[{"f", "'"}], "[", "var", "]"}]}]}], "]"}], "]"}]}], 
        "]"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"r", " ", "=", " ", "0.01"}], ";", "\n", "\t", 
      RowBox[{"limitInfo", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bailLoc", " ", "=", " ", "bail"}], ",", " ", 
           RowBox[{"rLoc", " ", "=", " ", "r"}], ",", " ", 
           RowBox[{"fLoc", " ", "=", " ", "f"}], ",", " ", 
           RowBox[{"nLoc", " ", "=", " ", "n"}]}], "}"}], ",", "\n", "\t   ", 
         
         RowBox[{"Compile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"z0", ",", " ", "_Complex"}], "}"}], "}"}], ",", "\n", 
           "\t\t", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"zz", ",", " ", "cnt"}], "}"}], ",", "\n", "\t\t ", 
             RowBox[{
              RowBox[{"cnt", " ", "=", " ", "0"}], ";", " ", 
              RowBox[{"zz", " ", "=", " ", "z0"}], ";", "\n", "\t\t ", 
              RowBox[{"While", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{"fLoc", "[", "zz", "]"}], "]"}], " ", ">", " ", 
                  "rLoc"}], " ", "&&", " ", 
                 RowBox[{"cnt", " ", "<", " ", "bailLoc"}]}], ",", "\n", 
                "\t\t  ", 
                RowBox[{
                 RowBox[{"zz", " ", "=", " ", 
                  RowBox[{"nLoc", "[", "zz", "]"}]}], ";", "\n", "\t\t  ", 
                 RowBox[{"cnt", " ", "=", " ", 
                  RowBox[{"cnt", " ", "+", " ", "1"}]}]}]}], "\n", "\t\t  ", 
               "]"}], ";", "\n", "\t\t ", 
              RowBox[{"{", 
               RowBox[{"zz", ",", " ", "cnt"}], "}"}]}]}], "]"}], ",", "\n", 
           "\t\t", 
           RowBox[{"RuntimeAttributes", " ", "->", " ", 
            RowBox[{"{", "Listable", "}"}]}], ",", "\n", "\t\t", 
           RowBox[{"Parallelization", " ", "->", " ", "True"}], ",", "\n", 
           "\t\t", 
           RowBox[{"RuntimeOptions", " ", "->", " ", "\"\<Speed\>\""}]}], 
          "\n", "\t\t", "]"}]}], "]"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"xmin", "=", 
       RowBox[{"Re", "[", "varMin", "]"}]}], ";", "\n", "\t", 
      RowBox[{"xmax", "=", 
       RowBox[{"Re", "[", "varMax", "]"}]}], ";", "\n", "\t", 
      RowBox[{"ymin", "=", 
       RowBox[{"Im", "[", "varMin", "]"}]}], ";", "\n", "\t", 
      RowBox[{"ymax", "=", 
       RowBox[{"Im", "[", "varMax", "]"}]}], ";", "\n", "\t", 
      RowBox[{"step", " ", "=", " ", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"xmax", "-", "xmin"}], ",", 
          RowBox[{"ymax", "-", "ymin"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"resolution", "+", "1"}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{"limitData", " ", "=", " ", 
       RowBox[{"limitInfo", "[", "\n", "\t  ", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", "*", "y"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", " ", "ymax", ",", "ymin", ",", " ", 
            RowBox[{"-", "step"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "xmin", ",", "xmax", ",", " ", "step"}], 
           "}"}]}], "]"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"roots", " ", "=", " ", 
       RowBox[{"z", " ", "/.", " ", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", "z", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "z"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
       RowBox[{"List", " ", "@@@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"61", ",", " ", "k"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "roots", "]"}]}], "}"}]}], "]"}]}]}], ";", 
      "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"preColors", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.0", ",", " ", "0.0", ",", " ", "0.0"}], "}"}]}], "]"}]}],
       ";", "\n", "\t", 
      RowBox[{"color", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bailLoc", " ", "=", " ", "bail"}], ",", " ", 
           RowBox[{"rootsLoc", " ", "=", " ", "roots"}], ",", " ", 
           RowBox[{"preColorsLoc", " ", "=", " ", "preColors"}]}], "}"}], ",",
          "\n", "\t   ", 
         RowBox[{"Compile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", ",", " ", "_Complex"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"cnt", ",", " ", "_Complex"}], "}"}]}], "}"}], ",", 
           "\n", "\t\t", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"arg", ",", " ", "time", ",", " ", "i"}], "}"}], ",", 
             "\n", "\t\t ", 
             RowBox[{
              RowBox[{"arg", " ", "=", " ", 
               RowBox[{"Arg", "[", "z", "]"}]}], ";", "\n", "\t\t ", 
              RowBox[{"time", " ", "=", " ", 
               RowBox[{"Abs", "[", "cnt", "]"}]}], ";", "\n", "\t\t ", 
              RowBox[{"i", " ", "=", " ", "1"}], ";", "\n", "\t\t ", 
