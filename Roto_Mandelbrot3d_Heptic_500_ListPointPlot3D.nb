               RowBox[{"zr", "^", "4"}]}], "-", 
              RowBox[{"7", " ", "yr", " ", 
               RowBox[{"zr", "^", "6"}]}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"zr2", "=", 
             RowBox[{"z0", "-", 
              RowBox[{"7", " ", 
