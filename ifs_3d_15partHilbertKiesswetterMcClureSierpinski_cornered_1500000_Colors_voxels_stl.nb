          RowBox[{
           RowBox[{"idx", "*", "voxel"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"idx", "+", "1"}], ")"}], "*", "voxel"}]}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"idx", ",", 
         RowBox[{"Keys", "[", "voxelAssoc", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
