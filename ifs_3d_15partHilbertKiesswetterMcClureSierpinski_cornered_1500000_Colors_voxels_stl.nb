        RowBox[{"(", 
         RowBox[{"idx", "->", "col"}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"build", " ", "colored", " ", "cuboids"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"cuboids", "=", 
