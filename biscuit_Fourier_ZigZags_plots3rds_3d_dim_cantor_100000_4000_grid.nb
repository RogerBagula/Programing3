Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hh", "[", "x_", "]"}], "=", 
   RowBox[{"ParallelSum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ff", "[", 
       RowBox[{
        RowBox[{"2", "^", "k"}], "*", "x"}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s0", "*", "k"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kk", "[", "x_", "]"}], "=", 
   RowBox[{"ParallelSum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ff", "[", 
       RowBox[{
        RowBox[{"2", "^", "k"}], "*", 
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"1", "/", "3"}]}], ")"}]}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s0", "*", "k"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "20"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ll", "[", "x_", "]"}], "=", 
   RowBox[{"ParallelSum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ff", "[", 
       RowBox[{
        RowBox[{"2", "^", "k"}], "*", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"1", "/", "3"}]}], ")"}]}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s0", "*", "k"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}]}], "Input",
