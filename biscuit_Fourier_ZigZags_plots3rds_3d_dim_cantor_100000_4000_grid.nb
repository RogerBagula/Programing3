Notebook[{
Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "f", ",", "g", ",", "h", ",", "k", ",", "v", ",", "ff", ",", "gg", ",", 
   "hh"}], "]"}]], "Input",
 CellChangeTimes->{3.535116041326825*^9, 3.5940567677138157`*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"eec3747e-a86a-401f-8acc-2cc9e360fe09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"ExpandAll", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"8", "/", 
       RowBox[{"Pi", "^", "2"}]}], ")"}], "*", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}]}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "*", "n"}], "-", "1"}], ")"}], "^", "2"}]}], ")"}], 
        
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "Pi", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "-", "1"}], ")"}], "*", 
          RowBox[{"x", "/", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "Infinity"}], "}"}]}], "]"}]}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.535116041326825*^9, 3.5940567677138157`*^9, {3.594689253386867*^9, 
   3.59468935000702*^9}, {3.59469041416617*^9, 3.59469042960077*^9}, 
   3.594815227336817*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"de77b910-be33-4d36-8561-ab7dd0899b5b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[ImaginaryI]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "x"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"LerchPhi", "[", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "8"}], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
          "x"}]]}], ",", "2", ",", 
       FractionBox["1", "2"]}], "]"}], "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"8", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "x"}]], " ", 
      RowBox[{"LerchPhi", "[", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"8", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", "x"}]]}], ",",
         "2", ",", 
        FractionBox["1", "2"]}], "]"}]}]}], ")"}]}], 
  SuperscriptBox["\[Pi]", "2"]]], "Output",
 CellChangeTimes->{3.594689438359069*^9, 3.594689776551442*^9, 
  3.594689864663224*^9, 3.5946904329323483`*^9, 3.5946905396975327`*^9, 
