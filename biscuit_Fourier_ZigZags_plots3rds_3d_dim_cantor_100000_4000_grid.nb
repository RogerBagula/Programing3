Cell[BoxData[{
 RowBox[{
  RowBox[{"ff", "[", "x_", "]"}], "=", 
  RowBox[{"f", "[", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "x", "]"}], ",", "1"}], "]"}], "]"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ff", "[", "x", "]"}], ",", 
     RowBox[{"ff", "[", 
      RowBox[{"x", "+", 
       RowBox[{"1", "/", "3"}]}], "]"}]}], "}"}], ",", 
