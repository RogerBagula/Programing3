Cell[BoxData[
 FractionBox[
  RowBox[{"\[ImaginaryI]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "4"}], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], ",", "1"}], "]"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"LerchPhi", "[", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "8"}], " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], ",", "1"}], "]"}]}]]}], ",", "2", 
       ",", 
       FractionBox["1", "2"]}], "]"}], "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"8", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "x", "]"}], ",", "1"}], "]"}]}]], " ", 
      RowBox[{"LerchPhi", "[", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"8", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], ",", "1"}], "]"}]}]]}], ",", "2",
         ",", 
        FractionBox["1", "2"]}], "]"}]}]}], ")"}]}], 
