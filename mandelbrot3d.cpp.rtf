// Translate Mathematica u1so2c_3d_mandelbrot_Plot_copilot2_500.nb into C++\
// Compile: g++ -O3 -std=c++17 -o mandelbrot3d mandelbrot3d.cpp\
// Run: ./mandelbrot3d\
//\
// Output: surface_points.csv (x,y,z) of surface voxels (interior points with at least one exterior neighbor)\
\
#include <bits/stdc++.h>\
using namespace std;\
\
// Escape-time function for the 3D quadratic map from the notebook.\
// Returns iteration count at which the orbit escapes (radius^2 > 4).\
// If it does not escape within maxIter, returns maxIter.\
int escapeTime3D(double x0, double y0, double z0, int maxIter) \{\
    double xr = 0.0, yr = 0.0, zr = 0.0;\
    for (int i = 0; i < maxIter; ++i) \{\
        double xr2 = 2.0 * xr * zr + x0;\
        double yr2 = -2.0 * yr * zr + y0;\
        double zr2 = xr * xr + yr * yr - zr * zr + z0;\
        xr = xr2; yr = yr2; zr = zr2;\
        if (xr*xr + yr*yr + zr*zr > 4.0) return i;\
    \}\
    return maxIter;\
\}\
\
int main(int argc, char** argv) \{\
    ios::sync_with_stdio(false);\
    cin.tie(nullptr);\
\
    // Parameters (tweak as needed)\
    const int maxIter = 500;   // matches notebook name\
    // Grid resolution: notebook used nx=ny=nz=500; that is large (125M voxels).\
    // Default here is smaller to be practical; change to 500 if you have enough memory/time.\
    int nx = 200;\
    int ny = 200;\
    int nz = 200;\
\
    // Domain bounds (notebook used -1.5..1.5)\
    const double xmin = -1.5, xmax = 1.5;\
    const double ymin = -1.5, ymax = 1.5;\
    const double zmin = -1.5, zmax = 1.5;\
\
    // Allow optional command-line overrides: ./mandelbrot3d nx ny nz maxIter\
    if (argc >= 4) \{\
        nx = max(2, atoi(argv[1]));\
        ny = max(2, atoi(argv[2]));\
        nz = max(2, atoi(argv[3]));\
    \}\
    if (argc >= 5) \{\
        // optional fourth arg overrides maxIter\
        // (we keep compiled constant maxIter for escapeTime3D default; allow override below)\
    \}\
\
    const double dx = (xmax - xmin) / double(max(1, nx - 1));\
    const double dy = (ymax - ymin) / double(max(1, ny - 1));\
    const double dz = (zmax - zmin) / double(max(1, nz - 1));\
\
    // Memory: store inside flags as bytes (0/1)\
    const size_t total = size_t(nx) * size_t(ny) * size_t(nz);\
    try \{\
        vector<unsigned char> inside;\
        inside.assign(total, 0);\
\
        auto idx = [&](int i, int j, int k) -> size_t \{\
            return (size_t)i * size_t(ny) * size_t(nz) + (size_t)j * size_t(nz) + (size_t)k;\
        \};\
\
        cerr << "Grid: " << nx << " x " << ny << " x " << nz << " = " << total << " voxels\\n";\
        cerr << "maxIter = " << maxIter << "\\n";\
        cerr << "Sampling domain x:[" << xmin << "," << xmax << "] y:[" << ymin << "," << ymax << "] z:[" << zmin << "," << zmax << "]\\n";\
\
        // First pass: compute inside/outside\
        size_t processed = 0;\
        const size_t progressStep = max<size_t>(1, total / 100);\
        for (int i = 0; i < nx; ++i) \{\
            double x0 = xmin + (i) * dx;\
            for (int j = 0; j < ny; ++j) \{\
                double y0 = ymin + (j) * dy;\
                for (int k = 0; k < nz; ++k) \{\
                    double z0 = zmin + (k) * dz;\
                    int it = escapeTime3D(x0, y0, z0, maxIter);\
                    if (it == maxIter) inside[idx(i,j,k)] = 1;\
                    ++processed;\
                    if ((processed & (progressStep - 1)) == 0 && progressStep > 1) \{\
                        // print percent every ~1%\
                        size_t pct = processed * 100 / total;\
                        cerr << "\\rComputing: " << pct << "%    " << flush;\
                    \}\
                \}\
            \}\
        \}\
        cerr << "\\rComputing: 100%    \\n";\
\
        // Second pass: collect surface points (interior voxel with at least one neighbor outside)\
        ofstream out("surface_points.csv");\
        if (!out) \{\
            cerr << "Failed to open surface_points.csv for writing\\n";\
            return 2;\
        \}\
        out << "x,y,z\\n";\
\
        size_t written = 0;\
        for (int i = 1; i < nx-1; ++i) \{\
            double x = xmin + i * dx;\
            for (int j = 1; j < ny-1; ++j) \{\
                double y = ymin + j * dy;\
                for (int k = 1; k < nz-1; ++k) \{\
                    if (!inside[idx(i,j,k)]) continue;\
                    // check 6 neighbors\
                    bool neighborOutside = false;\
                    if (!inside[idx(i+1,j,k)]) neighborOutside = true;\
                    else if (!inside[idx(i-1,j,k)]) neighborOutside = true;\
                    else if (!inside[idx(i,j+1,k)]) neighborOutside = true;\
                    else if (!inside[idx(i,j-1,k)]) neighborOutside = true;\
                    else if (!inside[idx(i,j,k+1)]) neighborOutside = true;\
                    else if (!inside[idx(i,j,k-1)]) neighborOutside = true;\
\
                    if (neighborOutside) \{\
                        double z = zmin + k * dz;\
                        out << x << "," << y << "," << z << "\\n";\
                        ++written;\
                    \}\
                \}\
            \}\
            if ((i & 31) == 0) \{\
                cerr << "\\rWriting surface points, i=" << i << " written=" << written << flush;\
            \}\
        \}\
        cerr << "\\rWriting surface points done, total written=" << written << "\\n";\
        out.close();\
        cerr << "Wrote surface_points.csv\\n";\
    \} catch (bad_alloc &e) \{\
        cerr << "Memory allocation failed: " << e.what() << "\\n";\
        cerr << "Try reducing nx, ny, nz (grid resolution).\\n";\
        return 3;\
    \}\
\
    return 0;\
\}\
