Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Mandelbulb", " ", "type", " ", "program", " ", "for", " ", "a", " ", 
    "ListSurfacePlot3D", " ", "double", " ", "program", " ", "written", " ", 
    "using", " ", "Paul", " ", 
    RowBox[{"Nylander", "'"}], "s", " ", "base", " ", "program", " ", "and", 
    " ", "voxels", " ", "idea"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "500"}], ";", 
    RowBox[{"m0", "=", "3"}], ";", 
    RowBox[{
     RowBox[{"norm", "[", "x_", "]"}], ":=", 
     RowBox[{"x", ".", "x"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BagulaSquare", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rxz2", "=", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rxz2", "\[Equal]", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"N", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"3", " ", "x", " ", "y"}], "2"], "+", 
             FractionBox[
              RowBox[{"5", " ", "x", " ", "z"}], "4"], "+", 
             RowBox[{
              FractionBox["1", "4"], " ", 
              SqrtBox["5"], " ", "x", " ", "z"}], "+", 
             RowBox[{
              FractionBox["1", "2"], " ", 
              SqrtBox[
               RowBox[{
                FractionBox["15", "8"], "-", 
                FractionBox[
                 RowBox[{"3", " ", 
                  SqrtBox["5"]}], "8"]}]], " ", "y", " ", "z"}]}], ",", 
            RowBox[{
             RowBox[{"x", " ", "y"}], "+", 
             SuperscriptBox["y", "2"], "+", 
             RowBox[{"2", " ", 
              SqrtBox[
               RowBox[{
                FractionBox["1", "3"], " ", 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["5", "8"], "-", 
                  FractionBox[
                   SqrtBox["5"], "8"]}], ")"}]}]], " ", "x", " ", "z"}], "+", 
             FractionBox[
              RowBox[{"5", " ", "y", " ", "z"}], "4"], "+", 
             RowBox[{
              FractionBox["1", "4"], " ", 
              SqrtBox["5"], " ", "y", " ", "z"}]}], ",", 
            RowBox[{
             RowBox[{
              FractionBox["1", "2"], " ", 
              SqrtBox[
               FractionBox["3", 
                RowBox[{
                 FractionBox["5", "8"], "-", 
                 FractionBox[
                  SqrtBox["5"], "8"]}]]], " ", "x", " ", "y"}], "+", 
             RowBox[{"x", " ", "z"}], "+", 
             FractionBox[
              RowBox[{"3", " ", "y", " ", "z"}], "2"], "+", 
             FractionBox[
              SuperscriptBox["z", "2"], "2"], "+", 
             FractionBox[
              RowBox[{
               SqrtBox["5"], " ", 
               SuperscriptBox["z", "2"]}], "2"]}]}], "}"}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Mandelbrot3D", "[", "pc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", "pc"}], ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "24"}], "&&", 
           RowBox[{
            RowBox[{"norm", "[", "p", "]"}], "<", "4"}]}], ",", 
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{
             RowBox[{"BagulaSquare", "[", "p", "]"}], "+", "pc"}]}], ";", 
           RowBox[{"i", "++"}]}]}], "]"}], ";", "i"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
