  RowBox[{
   RowBox[{"montreHenon", "[", 
    RowBox[{"x_", ",", "y_", ",", 
     RowBox[{"nbreFois_", ":", "200"}], ",", "opts___"}], "]"}], ":=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Hue", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"PointSize", "[", "0.005", "]"}], ",", 
        RowBox[{"Release", "[", 
         RowBox[{"Point", "/@", 
          RowBox[{"NestList", "[", 
           RowBox[{"f", ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], ",", "nbreFois"}], "]"}]}], 
