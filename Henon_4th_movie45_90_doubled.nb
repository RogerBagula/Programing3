  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", "t", "]"}], ",", 
       RowBox[{"Cos", "[", "t", "]"}]}], "}"}]}], "}"}], ".", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"y", "-", 
      SuperscriptBox["x", "4"]}]}], "}"}]}]}], "\n", 
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Graphics", ",", 
    RowBox[{"Background", "\[Rule]", 
     RowBox[{"GrayLevel", "[", "0.", "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "montreHenon", "]"}], ";"}], "\n", 
