Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RandomPolynomial", "[", 
    RowBox[{"x_", ",", "n_", ",", "r_List"}], "]"}], ":=", 
   RowBox[{"Nest", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "x"}], "+", 
       RowBox[{"Random", "[", 
        RowBox[{"Integer", ",", "r"}], "]"}]}], "&"}], ",", "0", ",", 
     RowBox[{"n", "+", "1"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"MahlerMeasure", "[", 
   RowBox[{"p_Integer", ",", "x_"}], "]"}], ":=", "0"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NMahlerMeasure", "[", 
    RowBox[{"p_Integer", ",", "x_"}], "]"}], ":=", "0"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MahlerMeasure", "[", 
    RowBox[{"p_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"roots", "=", 
       RowBox[{"x", "/.", 
        RowBox[{"{", 
         RowBox[{"ToRules", "[", 
          RowBox[{"Roots", "[", 
           RowBox[{
            RowBox[{"p", "\[Equal]", "0"}], ",", "x"}], "]"}], "]"}], 
         "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", "p"}], "]"}], "[", "0", "]"}], "]"}], " ", 
      RowBox[{"Times", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], ",", "1"}], "]"}], "&"}], "/@", 
         "roots"}], ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NMahlerMeasure", "[", 
    RowBox[{"p_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"roots", "=", 
       RowBox[{"x", "/.", 
        RowBox[{"{", 
         RowBox[{"ToRules", "[", 
          RowBox[{"NRoots", "[", 
           RowBox[{
            RowBox[{"p", "\[Equal]", "0"}], ",", "x"}], "]"}], "]"}], 
         "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", "p"}], "]"}], "[", "0", "]"}], "]"}], " ", 
      RowBox[{"Times", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"Abs", "[", "#", "]"}], ",", "1"}], "]"}], "&"}], "/@", 
         "roots"}], ")"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NMahlerMeasure2", "[", 
   RowBox[{"p_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"p", "/.", 
        RowBox[{"x", "\[Rule]", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", "Pi", " ", "I", " ", "t"}], "]"}]}]}], "]"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[285]:=",ExpressionUUID->"b111708a-8e80-4f0f-a220-c106d1c84a41"],

