Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Mandelbulb", " ", "type", " ", "program", " ", "for", " ", "a", " ", 
    "ListSurfacePlot3D", " ", "double", " ", "program", " ", "written", " ", 
    "using", " ", "Paul", " ", 
    RowBox[{"Nylander", "'"}], "s", " ", "base", " ", "program", " ", "and", 
    " ", "voxels", " ", "idea"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "500"}], ";", 
    RowBox[{"m0", "=", "3"}], ";", 
    RowBox[{
     RowBox[{"norm", "[", "x_", "]"}], ":=", 
     RowBox[{"x", ".", "x"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BagulaSquare", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rxz2", "=", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rxz2", "\[Equal]", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "x"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["x", "2"], "+", 
                  SuperscriptBox["y", "2"]}], ")"}], "2"]}], "+", 
              RowBox[{"10", " ", 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox["x", "2"], "+", 
                 SuperscriptBox["y", "2"]}], ")"}], " ", 
               SuperscriptBox["z", "2"]}], "-", 
              RowBox[{"5", " ", 
               SuperscriptBox["z", "4"]}]}], ")"}]}], ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               SuperscriptBox["x", "4"], " ", "y"}], "+", 
              RowBox[{"2", " ", 
               SuperscriptBox["x", "2"], " ", 
               SuperscriptBox["y", "3"]}], "+", 
              SuperscriptBox["y", "5"], "-", 
              RowBox[{"10", " ", 
               SuperscriptBox["x", "2"], " ", "y", " ", 
               SuperscriptBox["z", "2"]}], "-", 
              RowBox[{"10", " ", 
               SuperscriptBox["y", "3"], " ", 
               SuperscriptBox["z", "2"]}], "+", 
              RowBox[{"5", " ", "y", " ", 
               SuperscriptBox["z", "4"]}]}], ")"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "5"}], " ", 
             SuperscriptBox["x", "4"], " ", "z"}], "-", 
            RowBox[{"10", " ", 
             SuperscriptBox["x", "2"], " ", 
             SuperscriptBox["y", "2"], " ", "z"}], "-", 
            RowBox[{"5", " ", 
             SuperscriptBox["y", "4"], " ", "z"}], "+", 
            RowBox[{"10", " ", 
             SuperscriptBox["x", "2"], " ", 
             SuperscriptBox["z", "3"]}], "+", 
            RowBox[{"10", " ", 
             SuperscriptBox["y", "2"], " ", 
             SuperscriptBox["z", "3"]}], "-", 
            SuperscriptBox["z", "5"]}]}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Mandelbrot3D", "[", "pc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", "pc"}], ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "24"}], "&&", 
           RowBox[{
            RowBox[{"norm", "[", "p", "]"}], "<", "4"}]}], ",", 
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{
             RowBox[{"BagulaSquare", "[", "p", "]"}], "+", "pc"}]}], ";", 
           RowBox[{"i", "++"}]}]}], "]"}], ";", "i"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
