Cell["\<\
FractalPureM[{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
