            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"2", "*", "Pi", "*", "sc"}], "-", 
               RowBox[{"2", "*", 
                RowBox[{"Pi", "/", "3"}]}]}], "]"}], "*", "y"}]}], ",", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}], "-", 
            RowBox[{"z", "^", "2"}], "-", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"2", "*", "Pi", "*", "sc"}], "+", 
               RowBox[{"2", "*", 
                RowBox[{"Pi", "/", "3"}]}]}], "]"}], "*", "z"}]}]}], "}"}]}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Mandelbrot3D", "[", "pc_", "]"}], ":=", 
