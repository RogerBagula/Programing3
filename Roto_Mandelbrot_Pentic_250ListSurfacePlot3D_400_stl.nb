Cell[BoxData[
 RowBox[{
  RowBox[{"escapeTime3D", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z0", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"maxIter", ",", "_Integer"}], "}"}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xr", "=", "0."}], ",", 
         RowBox[{"yr", "=", "0."}], ",", 
         RowBox[{"zr", "=", "0."}], ",", "xr2", ",", "yr2", ",", "zr2", ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"i", "<", "maxIter"}], ",", 
          RowBox[{
           RowBox[{"xr2", "=", 
            RowBox[{"x0", "-", 
             RowBox[{"10", " ", 
              SuperscriptBox["xr", "3"], " ", 
              SuperscriptBox["yr", "2"]}], "+", 
             RowBox[{"5", " ", "xr", " ", 
              SuperscriptBox["yr", "4"]}], "+", 
             RowBox[{"10", " ", 
              SuperscriptBox["xr", "3"], " ", 
              SuperscriptBox["zr", "2"]}], "-", 
             RowBox[{"5", " ", "xr", " ", 
              SuperscriptBox["zr", "4"]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"yr2", "=", 
            RowBox[{"y0", "-", 
             RowBox[{"5", " ", 
              SuperscriptBox["xr", "4"], " ", "yr"}], "+", 
             RowBox[{"10", " ", 
              SuperscriptBox["xr", "2"], " ", 
              SuperscriptBox["yr", "3"]}], "-", 
             RowBox[{"10", " ", 
              SuperscriptBox["yr", "3"], " ", 
              SuperscriptBox["zr", "2"]}], "+", 
             RowBox[{"5", " ", "yr", " ", 
              SuperscriptBox["zr", "4"]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"zr2", "=", 
            RowBox[{"z0", "+", 
             RowBox[{"5", " ", 
              SuperscriptBox["xr", "4"], " ", "zr"}], "-", 
             RowBox[{"5", " ", 
              SuperscriptBox["yr", "4"], " ", "zr"}], "-", 
             RowBox[{"10", " ", 
              SuperscriptBox["xr", "2"], " ", 
              SuperscriptBox["zr", "3"]}], "+", 
             RowBox[{"10", " ", 
              SuperscriptBox["yr", "2"], " ", 
              SuperscriptBox["zr", "3"]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"xr", "=", "xr2"}], ";", 
           RowBox[{"yr", "=", "yr2"}], ";", 
           RowBox[{"zr", "=", "zr2"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"xr", "*", "xr"}], "+", 
               RowBox[{"yr", "*", "yr"}], "+", 
               RowBox[{"zr", "*", "zr"}]}], ">", "4.0"}], ",", 
             RowBox[{"Return", "[", "i", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        "maxIter"}]}], "]"}], ",", 
     RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], 
  "\n"}]], "Input",
