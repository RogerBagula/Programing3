Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dynamicNewtonPic", "[", 
    RowBox[{"fIn_", ",", " ", 
     RowBox[{"{", 
      RowBox[{"var_", ",", "varMin_", ",", "varMax_"}], "}"}], ",", " ", 
     "resolution_", ",", " ", 
