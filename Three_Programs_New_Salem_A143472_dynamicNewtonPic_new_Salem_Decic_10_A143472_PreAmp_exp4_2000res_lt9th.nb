              RowBox[{"image", "."}]}], " ", "*)"}], "]"}]}], "]"}]}], "\n", 
        "\t", "]"}]}], ";", "\n", "\t", 
      RowBox[{"colors", " ", "=", " ", 
       RowBox[{"Apply", "[", 
        RowBox[{"color", ",", " ", "limitData", ",", " ", 
