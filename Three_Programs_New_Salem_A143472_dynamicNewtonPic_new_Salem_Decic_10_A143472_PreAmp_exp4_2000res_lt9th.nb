       ",", " ", "limitData", ",", " ", "\n", "\t ", "r", ",", " ", "xmin", 
       ",", "xmax", ",", "ymin", ",", "ymax", ",", " ", "z", ",", " ", 
       "pic"}], "}"}], ",", "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", "fIn"}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"A", " ", "very", " ", "standard", " ", "example"}], " ", 
       "*)"}], "\n", "\t", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Simplify", "[", 
           RowBox[{"var", " ", "-", " ", 
            RowBox[{
             RowBox[{"f", "[", "var", "]"}], "/", 
             RowBox[{
              RowBox[{"f", "'"}], "[", "var", "]"}]}]}], "]"}], "]"}]}], 
        "]"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"r", " ", "=", " ", "0.01"}], ";", "\n", "\t", 
      RowBox[{"limitInfo", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bailLoc", " ", "=", " ", "bail"}], ",", " ", 
           RowBox[{"rLoc", " ", "=", " ", "r"}], ",", " ", 
           RowBox[{"fLoc", " ", "=", " ", "f"}], ",", " ", 
           RowBox[{"nLoc", " ", "=", " ", "n"}]}], "}"}], ",", "\n", "\t   ", 
         
         RowBox[{"Compile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"z0", ",", " ", "_Complex"}], "}"}], "}"}], ",", "\n", 
           "\t\t", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"zz", ",", " ", "cnt"}], "}"}], ",", "\n", "\t\t ", 
             RowBox[{
              RowBox[{"cnt", " ", "=", " ", "0"}], ";", " ", 
              RowBox[{"zz", " ", "=", " ", "z0"}], ";", "\n", "\t\t ", 
              RowBox[{"While", "[", 
