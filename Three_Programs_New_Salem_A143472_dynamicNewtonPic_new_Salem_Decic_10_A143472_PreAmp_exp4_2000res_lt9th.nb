                RowBox[{"{", 
                 RowBox[{"Thick", ",", "Purple", ",", 
                  RowBox[{"Dynamic", "[", 
                   RowBox[{"Line", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Re", "[", "#", "]"}], ",", 
                    RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], " ", "/@", 
