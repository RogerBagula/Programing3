          RowBox[{
           RowBox[{"f", "[", "z", "]"}], " ", "==", " ", "0"}], ",", " ", 
          "z"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
       RowBox[{"List", " ", "@@@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"61", ",", " ", "k"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "roots", "]"}]}], "}"}]}], "]"}]}]}], ";", 
      "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
       RowBox[{"Append", "[", 
        RowBox[{"preColors", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0.0", ",", " ", "0.0", ",", " ", "0.0"}], "}"}]}], "]"}]}],
