       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"xmax", "-", "xmin"}], ",", 
          RowBox[{"ymax", "-", "ymin"}]}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"resolution", "+", "1"}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{"limitData", " ", "=", " ", 
       RowBox[{"limitInfo", "[", "\n", "\t  ", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", "*", "y"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", " ", "ymax", ",", "ymin", ",", " ", 
            RowBox[{"-", "step"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "xmin", ",", "xmax", ",", " ", "step"}], 
           "}"}]}], "]"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"roots", " ", "=", " ", 
       RowBox[{"z", " ", "/.", " ", 
