Cell[CellGroupData[{

Cell["3D Mandelbrot of an SU(2) type of serial pre-transform", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"90a2f7ab-c94d-4f8c-8e5f-0a9212358990"],

Cell["\<\
(*Mandelbrot with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 25 Mov 2005 \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 16) && (escapeCount < 255) && \
(Abs[nz-nzold]>10^(-3)),
\t\tnzold=nz;
\t\tnz=g[nz,z];
\t\t++escapeCount
\t];
\tescapeCount*(1-Abs[Arg[nz]/(2*Pi)])
]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.636885471970562*^9, 3.636885495570519*^9}, {
   3.636886113868834*^9, 3.636886158088616*^9}, 3.636886228723032*^9, {
   3.6368863559522676`*^9, 3.636886382516387*^9}, {3.636886470482922*^9, 
   3.636886476746613*^9}, {3.638610154542932*^9, 3.638610174869956*^9}, {
   3.638610455194001*^9, 3.6386104560238667`*^9}, {3.638624378329419*^9, 
   3.6386244071612453`*^9}, {3.638626362577973*^9, 3.638626368057702*^9}, {
   3.6394765439015093`*^9, 3.6394765644813557`*^9}, 3.639477346192004*^9, {
   3.639482630616947*^9, 3.6394826309741907`*^9}, 3.6395590670037127`*^9, 
   3.6395599671518173`*^9, {3.639560203459401*^9, 3.639560208195641*^9}, {
   3.639588720572783*^9, 3.639588726350575*^9}, {3.6408674990619917`*^9, 
   3.640867507777474*^9}, {3.641555576035221*^9, 3.641555610352748*^9}, {
   3.641556630727665*^9, 3.64155665790734*^9}, {3.641556744492338*^9, 
   3.641556747529778*^9}, {3.641556779530822*^9, 3.641556804466545*^9}, 
   3.641557239287551*^9, 3.6415575213829193`*^9, {3.641563622017761*^9, 
   3.641563656080318*^9}, 3.6440526745700827`*^9, {3.9866975899113398`*^9, 
   3.986697627029791*^9}, {3.9866976716124353`*^9, 3.986697679580208*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->
  "In[307]:=",ExpressionUUID->"d3ec51bd-436a-4b62-88d9-36f275343e26"],

Cell["\<\
FractalPure[m_][{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.98634810157062*^9, 3.986348105434379*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->
  "In[310]:=",ExpressionUUID->"15c1afa2-0d5a-4ee7-baa0-71b3d7f2004e"],

