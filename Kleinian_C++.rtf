\f0\fs24 \cf0 // ============================================================\
//   Fast Kleinian two\uc0\u8209 trace escape\u8209 time function (Maskit slice)\
//   Faithful translation of Mathematica's compiled kleinC2[]\
// ============================================================\
\
#include <complex>\
#include <cmath>\
\
using std::complex;\
\
int kleinC2(const complex<double>& z,\
            const complex<double>& t1,\
            const complex<double>& t2)\
\{\
    double xi = z.real();\
    double yi = z.imag();\
\
    // choose which trace controls separation line\
    complex<double> tForSep = t2;\
    complex<double> tA = t1;\
    complex<double> tB = t2;\
\
    double u = tForSep.real();\
    double v = tForSep.imag();\
\
    // quick bounding check\
    if (yi < 0.0 || yi > u)\
        return 0;\
\
    complex<double> zi(1.0, 1.0);\
    complex<double> low(1.0, 1.0);\
    complex<double> high(1.0, 1.0);\
\
    int k = 1;\
\
    for (int n = 1; n <= 30; ++n)\
    \{\
        // fold x coordinate into fundamental strip\
        xi = std::fmod(xi + 1.0 + v * yi / u, 2.0) - 1.0 - v * yi / u;\
        zi = complex<double>(xi, yi);\
\
        // separation line test\
        double sep = u/2.0 + std::copysign(1.0, xi + v/2.0)\
                     * 0.2 * u * (1.0 - std::exp(-5.0 * std::abs(xi + v/2.0)));\
\
        if (yi < sep)\
        \{\
            // branch A: use tA\
            if (std::abs(zi - low) < 1e-4)\
            \{\
                k = -n;\
                break;\
            \}\
            low = zi;\
            k = 1;\
\
            // M\'f6bius-like step: zi = i*tA + 1/zi\
            zi = complex<double>(0,1) * tA + 1.0 / zi;\
        \}\
        else\
        \{\
            // branch B: use tB\
            if (std::abs(zi - high) < 1e-4)\
            \{\
                k = -n;\
                break;\
            \}\
            high = zi;\
\
            // M\'f6bius-like step: zi = i / (i*zi + tB)\
            zi = complex<double>(0,1) / (complex<double>(0,1)*zi + tB);\
            k = 2;\
        \}\
\
        xi = zi.real();\
        yi = zi.imag();\
\
        if (yi < 0.0 || yi > u)\
            break;\
\
        k = 3;\
    \}\
\
    return k;\
\}\
}