         RowBox[{"Compile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"z0", ",", " ", "_Complex"}], "}"}], "}"}], ",", "\n", 
           "\t\t", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"zz", ",", " ", "cnt"}], "}"}], ",", "\n", "\t\t ", 
             RowBox[{
              RowBox[{"cnt", " ", "=", " ", "0"}], ";", " ", 
              RowBox[{"zz", " ", "=", " ", "z0"}], ";", "\n", "\t\t ", 
              RowBox[{"While", "[", 
