       "pic"}], "}"}], ",", "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", "fIn"}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"A", " ", "very", " ", "standard", " ", "example"}], " ", 
       "*)"}], "\n", "\t", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"var", ",", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Simplify", "[", 
           RowBox[{"var", " ", "-", " ", 
            RowBox[{
             RowBox[{"f", "[", "var", "]"}], "/", 
             RowBox[{
              RowBox[{"f", "'"}], "[", "var", "]"}]}]}], "]"}], "]"}]}], 
        "]"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"r", " ", "=", " ", "0.01"}], ";", "\n", "\t", 
      RowBox[{"limitInfo", " ", "=", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bailLoc", " ", "=", " ", "bail"}], ",", " ", 
           RowBox[{"rLoc", " ", "=", " ", "r"}], ",", " ", 
           RowBox[{"fLoc", " ", "=", " ", "f"}], ",", " ", 
