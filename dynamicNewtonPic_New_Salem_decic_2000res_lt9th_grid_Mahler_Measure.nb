               "]"}], ";", "\n", "\t\t ", 
              RowBox[{"{", 
               RowBox[{"zz", ",", " ", "cnt"}], "}"}]}]}], "]"}], ",", "\n", 
           "\t\t", 
           RowBox[{"RuntimeAttributes", " ", "->", " ", 
            RowBox[{"{", "Listable", "}"}]}], ",", "\n", "\t\t", 
