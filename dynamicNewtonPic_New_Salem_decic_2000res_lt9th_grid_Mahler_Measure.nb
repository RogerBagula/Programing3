           RowBox[{"k", ",", " ", "1", ",", " ", 
            RowBox[{"Length", "[", "roots", "]"}]}], "}"}]}], "]"}]}]}], ";", 
      "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
