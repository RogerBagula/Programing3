          "z"}], "]"}]}]}], ";", "\n", "\t", 
      RowBox[{"preColors", " ", "=", " ", 
       RowBox[{"List", " ", "@@@", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"61", ",", " ", "k"}], "]"}], ",", " ", 
