                  "rLoc"}], " ", "&&", " ", 
                 RowBox[{"cnt", " ", "<", " ", "bailLoc"}]}], ",", "\n", 
                "\t\t  ", 
                RowBox[{
                 RowBox[{"zz", " ", "=", " ", 
