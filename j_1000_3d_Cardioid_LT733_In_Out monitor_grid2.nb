  3.987502963278672*^9}},ExpressionUUID->"c4617eb2-44bb-4857-bffb-\
4349ed80d483"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"cNumberOfz2ToEscape", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"z", ",", "_Complex"}], "}"}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"escapeCount", "=", "0"}], ",", 
          RowBox[{"nz", "=", 
           RowBox[{"N", "[", "z", "]"}]}], ",", 
          RowBox[{"nzold", "=", 
           RowBox[{"0.", "+", 
            RowBox[{"0.", " ", "I"}]}]}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", "nz", "]"}], "^", "2"}], "+", 
               RowBox[{
                RowBox[{"Im", "[", "nz", "]"}], "^", "2"}]}], "]"}], "<", 
             "16."}], "&&", 
            RowBox[{"escapeCount", "<", "255"}], "&&", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"nz", "-", "nzold"}], "]"}], ">", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "3"}]}]}]}], ",", 
           RowBox[{
            RowBox[{"nzold", "=", "nz"}], ";", "\[IndentingNewLine]", 
            RowBox[{"nz", "=", 
             RowBox[{
              RowBox[{"nz", "^", "2"}], "+", "c"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{"same", " ", "as", " ", 
              RowBox[{"g", "[", 
               RowBox[{"nz", ",", "z"}], "]"}], " ", "but", " ", "inlined"}], 
             "*)"}], 
            RowBox[{"escapeCount", "++"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"escapeCount", "*", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"nz", "-", "nzold"}], "]"}], ">", 
             RowBox[{"10.", "^", 
              RowBox[{"-", "3"}]}]}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"ArcTan", "[", "nz", "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{"ArcTan", "[", "nz", "]"}], " ", 
               RowBox[{"Tan", "[", "1.", "]"}]}], "-", 
              RowBox[{"Arg", "[", "z", "]"}]}], "]"}], ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"Arg", "[", "nz", "]"}], "]"}]}], "]"}]}]}]}], "]"}], 
      ",", 
      RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
      RowBox[{"CompilationOptions", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<InlineExternalDefinitions\>\"", "->", "True"}], 
        "}"}]}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9872926995979223`*^9, 3.987292699599921*^9}, 
   3.9875009187191143`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"689175e5-9f88-48ef-acd0-5dd284f0473d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FractalPureCompiled", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ReMin_", ",", "ReMax_", ",", "ReSteps_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ImMin_", ",", "ImMax_", ",", "ImSteps_"}], "}"}]}], "}"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xs", ",", "ys"}], "}"}], ",", 
     RowBox[{
      RowBox[{"xs", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"ReMin", ",", "ReMax", ",", "ReSteps"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ys", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"ImMin", ",", "ImMax", ",", "ImSteps"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"cNumberOfz2ToEscape", "[", 
         RowBox[{"x", "+", 
          RowBox[{"I", " ", "y"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "ys"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xs"}], "}"}]}], "]"}]}]}], "]"}]}], 
  "\n"}]], "Input",
