\f0\fs24 \cf0 #include <complex>\
using namespace std;\
\
int kleinC2(complex<double> z, complex<double> t1, complex<double> t2)\
\{\
    double xi = real(z);\
    double yi = imag(z);\
\
    double u = real(t2);   // tForSep = t2\
    double v = imag(t2);\
\
    // quick bounding check\
    if (yi < 0.0 || yi > u)\
        return 0;\
\
    complex<double> zi(1.0, 1.0);\
    complex<double> low(1.0, 1.0);\
    complex<double> high(1.0, 1.0);\
\
    int k = 1;\
\
    for (int n = 1; n <= 30; n++)\
    \{\
        // fold x coordinate into fundamental strip\
        xi = fmod(xi + 1.0 + v * yi / u, 2.0);\
        if (xi < 0) xi += 2.0;\
        xi = xi - 1.0 - v * yi / u;\
\
        zi = complex<double>(xi, yi);\
\
        // separation-line test\
        double sep = u/2.0 + ((xi + v/2.0) >= 0 ? 1 : -1)\
                     * 0.2 * u * (1.0 - exp(-5.0 * fabs(xi + v/2.0)));\
\
        if (yi < sep)\
        \{\
            // branch A: use t1\
            if (abs(zi - low) < 1e-4) \{ k = -n; break; \}\
            low = zi;\
            k = 1;\
            zi = complex<double>(0,1) * t1 + 1.0 / zi;\
        \}\
        else\
        \{\
            // branch B: use t2\
            if (abs(zi - high) < 1e-4) \{ k = -n; break; \}\
            high = zi;\
            zi = complex<double>(0,1) / (complex<double>(0,1)*zi + t2);\
            k = 2;\
        \}\
\
        xi = real(zi);\
        yi = imag(zi);\
\
        if (yi < 0.0 || yi > u)\
            break;\
\
        k = 3;\
    \}\
\
    return k;\
\}\
}