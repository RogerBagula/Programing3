 FontSize->14,
 CellLabel->"In[15]:=",ExpressionUUID->"7f2bb8d8-3955-4d53-aff0-80aa9b83f9b1"],

Cell["\<\
FractalPure[m_][{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.981486969351581*^9, 3.981486973074781*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[18]:=",ExpressionUUID->"cc47d1d8-6d03-4c68-ad90-affa31f09e69"],

