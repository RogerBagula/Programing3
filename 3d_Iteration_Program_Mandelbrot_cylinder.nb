Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "CoPilot", " ", "Mathematica", " ", "translation", " ", "of", " ", "a", 
    " ", "Python", " ", 
    RowBox[{"Program", ":", "\[IndentingNewLine]", 
     RowBox[{
     "Example", " ", "pseudocode", " ", "for", " ", "3", "D", " ", "escape", 
      " ", "time"}], ":", 
     RowBox[{"def", " ", "escape_time", "_", "3", "d", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y", ",", "z", ",", "c"}], ")"}]}], ":", "z"}]}], 
   "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"complex", 
       RowBox[{"(", 
        RowBox[{"x", ",", "y"}], ")"}]}], "+", 
      RowBox[{"complex", 
       RowBox[{"(", 
        RowBox[{"0", ",", "z"}], ")"}], " ", "#", " ", "3", "D", " ", "to", 
       " ", "complex", "\n", "for", " ", "i", " ", "in", " ", "range", 
       RowBox[{"(", "max_iter", ")"}]}]}], ":", "z"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"z", "**", "2"}], "+", 
       RowBox[{"c", "\n", "if", " ", "abs", 
        RowBox[{"(", "z", ")"}]}]}], ">", "2"}], ":", 
     RowBox[{"return", " ", "i", "\n", "return", " ", "max_iter"}]}]}]}], 
  "\n", "*)"}]], "Input",
 CellChangeTimes->{{3.986852973109219*^9, 3.986853009433753*^9}, {
  3.986853065063466*^9, 
  3.986853100430036*^9}},ExpressionUUID->"820087f4-5d98-4a03-abcb-\
a0318ea49cb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"escapeTime3D", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"cRe", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"cIm", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"maxIter", ",", "_Integer"}], "}"}]}], "}"}], ",", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"zr", "=", "x"}], ",", 
         RowBox[{"zi", "=", 
          RowBox[{"y", "+", "z"}]}], ",", 
         RowBox[{"cr", "=", "cRe"}], ",", 
         RowBox[{"ci", "=", "cIm"}], ",", "r2", ",", 
         RowBox[{"i", "=", "0"}], ",", "zr2", ",", "zi2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"i", "<", "maxIter"}], ",", 
          RowBox[{
           RowBox[{"zr2", "=", 
            RowBox[{
             RowBox[{"zr", "*", "zr"}], "-", 
             RowBox[{"zi", "*", "zi"}], "+", "cr"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zi2", "=", 
            RowBox[{
             RowBox[{"2", "*", "zr", "*", "zi"}], "+", "ci"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"zr", "=", "zr2"}], ";", "\[IndentingNewLine]", 
           RowBox[{"zi", "=", "zi2"}], ";", "\[IndentingNewLine]", 
           RowBox[{"r2", "=", 
            RowBox[{
             RowBox[{"zr", "*", "zr"}], "+", 
             RowBox[{"zi", "*", "zi"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"r2", ">", "4."}], ",", 
             RowBox[{"Return", "[", "i", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        "maxIter"}]}], "]"}], ",", 
     RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
     RowBox[{"Parallelization", "->", "True"}]}], "]"}]}], ";"}]], "Input",
