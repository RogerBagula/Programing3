Cell[BoxData[{
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Log", "[", "2", "]"}], "/", 
     RowBox[{"Log", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SawtoothWave", "[", 
       RowBox[{
        RowBox[{"2", "^", "n"}], "*", "x"}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s", "*", "n"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SawtoothWave", "[", 
       RowBox[{
        RowBox[{"2", "^", "n"}], "*", 
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"1", "/", "3"}]}], ")"}]}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s", "*", "n"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SawtoothWave", "[", 
       RowBox[{
        RowBox[{"2", "^", "n"}], "*", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"1", "/", "3"}]}], ")"}]}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"s", "*", "n"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}]}], "Input",
