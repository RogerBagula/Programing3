Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Mandelbulb", " ", "type", " ", "program", " ", "for", " ", "a", " ", 
    "ListSurfacePlot3D", " ", "double", " ", "program", " ", "written", " ", 
    "using", " ", "Paul", " ", 
    RowBox[{"Nylander", "'"}], "s", " ", "base", " ", "program", " ", "and", " ",
     "voxels", " ", "idea"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "500"}], ";", 
    RowBox[{"m0", "=", "3"}], ";", 
    RowBox[{
     RowBox[{"norm", "[", "x_", "]"}], ":=", 
     RowBox[{"x", ".", "x"}]}], ";", 
    RowBox[{"pc0", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0.6176710261974764", ",", "0.692277537822295"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BagulaSquare", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rxz2", "=", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rxz2", "\[Equal]", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "*", "x", "*", "z"}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], "*", "y", "*", "z"}], ",", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}], "-", 
            RowBox[{"z", "^", "2"}]}]}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Mandelbrot3D", "[", "pc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", "pc"}], ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "24"}], "&&", 
           RowBox[{
            RowBox[{"norm", "[", "p", "]"}], "<", "4"}]}], ",", 
          RowBox[{
           RowBox[{"p", "=", 
            RowBox[{
             RowBox[{"BagulaSquare", "[", "p", "]"}], "+", "pc0"}]}], ";", 
           RowBox[{"i", "++"}]}]}], "]"}], ";", "i"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{
